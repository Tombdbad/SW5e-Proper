# The SW5e app as a service: starts at boot, restarts if it stops.
# Install: sudo cp deploy/sw5e.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now sw5e
# It listens on 127.0.0.1:5000 only (HOST is not set). Tailscale Serve puts it on the tailnet over HTTPS.
[Unit]
Description=SW5e RPG simulator
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/SW5e-Proper
# DATABASE_URL comes from .env; NODE_ENV is forced here because .env says development
EnvironmentFile=/home/ubuntu/SW5e-Proper/.env
ExecStart=/usr/bin/env NODE_ENV=production /usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
