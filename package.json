{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "e2e": "node e2e/play.mjs",
    "import:sw5e": "tsx shared/scripts/import-sw5e.ts",
    "test": "node --import tsx --test tests/*/*.test.ts",
    "test:interiors": "node --import tsx --test tests/interiors/*.test.ts",
    "test:assets": "node --import tsx --test tests/interiors/assets.test.ts",
    "test:weapons": "node --import tsx --test tests/interiors/weapons.test.ts tests/interiors/stock.test.ts",
    "test:atmosphere": "node --import tsx --test tests/interiors/atmosphere.test.ts tests/interiors/wealth.test.ts",
    "test:caves": "node --import tsx --test tests/interiors/cave.test.ts tests/interiors/footprint.test.ts",
    "convert:assets": "node tools/convert-assets.mjs",
    "coverage:models": "node --import tsx tools/model-coverage.ts",
    "audit:items": "node --import tsx tools/item-audit.ts",
    "build:items": "node tools/build-item-assets.mjs",
    "test:items": "node --import tsx --test tests/items/*.test.ts",
    "test:coop": "node --import tsx --test tests/server/coop.test.ts",
    "build:icons": "node tools/build-icons.mjs"
  },
